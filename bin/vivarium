#!/usr/bin/env node
// vivarium — control Obsidian Vivarium tiles from any terminal (or from an agent running inside one).
//
// Canvas ops (add/fork/note/move/focus/rm/ls/me) go to the Obsidian plugin over ~/.vivarium/<vault>.sock.
// Program I/O (send/read/wait/keys) goes straight to tmux, so it works even when Obsidian is closed.
// Inside a Vivarium tile, $VIVARIUM_TILE is that tile's id and is the default tile everywhere
// except `rm`.
//
// Output is kept short on purpose: agents pay for every line they read.
"use strict";
const net = require("net");
const fs = require("fs");
const os = require("os");
const path = require("path");
const { execFileSync } = require("child_process");

const SOCKET = process.env.VIVARIUM_TMUX_SOCKET || "vivarium";
const SESSION = "vivarium";
const HERE = process.env.VIVARIUM_TILE || "";

const HELP = `vivarium: program tiles on an Obsidian canvas.${HERE ? ` You are tile ${HERE}.` : ""}
Ids look like t3k9x2a. Without one, commands act on your own tile (except rm).

  ls [--all]                    tiles on open canvases (--all: every card, with positions)
  me                            your tile: title, canvas, folder, agent conversation
  add [--title T] [--cwd D] [--label L] -- <cmd…>
                                new tile next to yours, arrow from yours; prints its id
  fork [--title T] [prompt…]    continue your Codex/Claude conversation in a new tile next to yours
  note [--color 1-6] <text…>    text card next to your tile
  send ID <text…> [--wait]      type text + Enter (--no-enter); --wait: wait until done, print screen
  read ID [--lines N]           screen (+N lines of history), blank lines squeezed
  wait ID [--for REGEX] [--idle S] [--timeout S]
                                until the program is done (back at its prompt / quiet), print screen
  keys ID <key…>                tmux keys: C-c, Escape, Up, Enter, …
  move ID X,Y [WxH] | focus ID | rm ID | attach ID

  --near ID: place next to another tile instead of yours.  --vault NAME if several vaults run it.
  --json: raw output.  Without the Obsidian plugin: vivarium setup [--codex-rules] [--remove]`;

const BOOL = new Set(["no-edge", "no-enter", "json", "help", "all", "wait", "remove", "codex-rules"]);
function parse(argv) {
	const flags = {}, pos = [];
	for (let i = 0; i < argv.length; i++) {
		const a = argv[i];
		if (a === "--") { pos.push(...argv.slice(i + 1)); break; }
		if (a.startsWith("--") && a.length > 2) {
			const [k, v] = a.slice(2).split(/=(.*)/s);
			if (v !== undefined) flags[k] = v;
			else if (BOOL.has(k)) flags[k] = true;
			else flags[k] = argv[++i];
		} else pos.push(a);
	}
	return { flags, pos };
}

function die(msg) { process.stderr.write(`vivarium: ${msg}\n`); process.exit(1); }

function sockPath(vault) {
	// inside a tile: exactly its own vault's socket
	if (!vault && process.env.VIVARIUM_SOCKET && fs.existsSync(process.env.VIVARIUM_SOCKET)) return process.env.VIVARIUM_SOCKET;
	const dir = path.join(os.homedir(), ".vivarium");
	vault = vault || process.env.VIVARIUM_VAULT; // older tiles only know their vault's name
	let socks = [];
	try { socks = fs.readdirSync(dir).filter((f) => f.endsWith(".sock")); } catch {}
	// sockets are "<vault>-<hash of its path>.sock" (two vaults can share a name)
	const name = (f) => f.slice(0, -5).replace(/-[0-9a-f]{8}$/, "");
	if (vault) {
		const want = vault.replace(/[^\w.-]+/g, "_");
		const hits = socks.filter((f) => name(f) === want);
		if (hits.length === 1) return path.join(dir, hits[0]);
		if (hits.length > 1) die(`several open vaults are called "${vault}"; run this inside one of its tiles`);
		die(`no running Obsidian vault "${vault}" with Vivarium`);
	}
	if (socks.length === 1) return path.join(dir, socks[0]);
	if (!socks.length) die("Obsidian with the Vivarium plugin doesn't seem to be running (no socket in ~/.vivarium).");
	die(`several vaults are running Vivarium (${socks.map(name).join(", ")}); pass --vault NAME`);
}

function rpc(vault, req) {
	return new Promise((resolve, reject) => {
		const s = net.createConnection(sockPath(vault));
		let buf = "";
		s.on("connect", () => s.write(JSON.stringify(req) + "\n"));
		s.on("data", (d) => {
			buf += d;
			const nl = buf.indexOf("\n");
			if (nl < 0) return;
			s.end();
			const res = JSON.parse(buf.slice(0, nl));
			res.ok ? resolve(res) : reject(new Error(res.error));
		});
		s.on("error", (e) => {
			if (e.code === "EPERM" || e.code === "EACCES") reject(new Error("blocked by a sandbox: run this command outside it (approve it, or turn on Codex: no sandbox prompts in Vivarium settings)"));
			else reject(new Error(e.code === "ECONNREFUSED" || e.code === "ENOENT" ? "Obsidian isn't running Vivarium for this vault" : e.message));
		});
	});
}

function findTmux() {
	for (const p of ["/opt/homebrew/bin/tmux", "/usr/local/bin/tmux", "/usr/bin/tmux", "/run/current-system/sw/bin/tmux"]) if (fs.existsSync(p)) return p;
	return "tmux";
}
const TMUX = findTmux();
function tmux(...args) {
	try { return execFileSync(TMUX, ["-L", SOCKET, ...args], { encoding: "utf8", stdio: ["ignore", "pipe", "pipe"] }); }
	catch (e) {
		const msg = (e.stderr || e.message).trim();
		if (/Operation not permitted|Permission denied/.test(msg)) die("blocked by a sandbox: run this command outside it (approve it, or turn on Codex: no sandbox prompts in Vivarium settings)");
		if (/no server running|error connecting/.test(msg)) die("no tiles are running (Vivarium's tmux isn't up)");
		die(msg);
	}
}
const target = (id) => `${SESSION}:=${id}`;
const sleep = (ms) => Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, ms);

let windows = null;
function tileExists(id) {
	windows ??= new Set(tmux("list-windows", "-t", SESSION, "-F", "#{window_name}").split("\n"));
	return windows.has(id);
}
const looksLikeId = (s) => /^t[a-z0-9]{4,8}$/.test(s || "");

/** The tile a command is about: a leading id, else your own tile. */
function takeId(pos, { here = true } = {}) {
	if (looksLikeId(pos[0])) {
		// "tokens are …" is text, not a tile: only take it when such a tile exists
		if (tileExists(pos[0]) || pos.length === 1 || !here || !HERE) {
			const id = pos.shift();
			if (!tileExists(id)) die(`no running tile ${id} (see vivarium ls)`);
			return id;
		}
	}
	if (here && HERE) return HERE;
	die(here ? "which tile? pass an id (see vivarium ls)" : "pass a tile id (see vivarium ls)");
}

// ---------- screens ----------

/** Screen text with trailing spaces cut and runs of blank lines squeezed: cheap to read. */
function compact(s) {
	const out = [];
	for (const l of s.split("\n").map((l) => l.replace(/\s+$/, ""))) {
		if (!l && (!out.length || !out[out.length - 1])) continue;
		out.push(l);
	}
	while (out.length && !out[out.length - 1]) out.pop();
	return out.join("\n") + "\n";
}

function capture(id, lines = 0) {
	return tmux("capture-pane", "-p", "-J", "-t", target(id), ...(lines ? ["-S", String(-lines)] : []));
}

const SHELLS = new Set(["zsh", "bash", "fish", "sh", "dash", "ksh", "tcsh", "nu"]);
function paneState(id) {
	const [cmd, dead] = tmux("display-message", "-p", "-t", target(id), "#{pane_current_command}\t#{pane_dead}").trim().split("\t");
	return { atShell: SHELLS.has(path.basename(cmd || "").replace(/^-/, "")), dead: dead === "1" };
}

// Spinners and timers ("Working (12s • esc to interrupt)") change while a program is busy but
// says nothing new: ignore them when deciding whether the screen settled.
const norm = (s) => s.replace(/[0-9]/g, "").replace(/[⠀-⣿─-➿·•◦]/g, "");
const BUSY = /esc to interrupt|ctrl\+c to interrupt/i;

/**
 * Wait until a program is done: back at the shell prompt, exited, or quiet for `idle` seconds
 * while not showing a "busy" line (Codex and Claude Code show "esc to interrupt" while working).
 */
function waitDone(id, { idle = 3, timeout = 300, pattern = null, minMs = 600 } = {}) {
	const re = pattern ? new RegExp(pattern, "m") : null;
	const t0 = Date.now();
	let last = null, since = Date.now(), screen = "";
	for (;;) {
		screen = capture(id);
		const st = paneState(id);
		const n = norm(screen);
		if (n !== last) { last = n; since = Date.now(); }
		const quiet = Date.now() - since;
		if (re && re.test(screen)) return { screen, why: "matched" };
		if (st.dead) return { screen, why: "exited" };
		if (!re && Date.now() - t0 >= minMs) {
			if (st.atShell && quiet >= 500) return { screen, why: "at prompt" };
			if (!st.atShell && quiet >= idle * 1000 && !BUSY.test(screen)) return { screen, why: "quiet" };
		}
		if (Date.now() - t0 > timeout * 1000) return { screen, why: `timeout after ${timeout}s, still running` };
		sleep(250);
	}
}

function printWait(r, flags) {
	process.stdout.write(compact(r.screen));
	if (r.why.startsWith("timeout") || flags.json) process.stderr.write(`[${r.why}]\n`);
}

// ---------- setup ----------
// The Obsidian plugin does this on its own (Settings → Vivarium → Coding agents); `vivarium setup`
// is for machines where you use the CLI without it, or to add the Codex rule from a terminal.

const CODEX_RULES = `# Written by the Vivarium plugin (Settings → Vivarium → Agents). Lets Codex run these vivarium
# commands outside its sandbox without asking: they need Obsidian's socket and tmux, which the
# sandbox blocks. Commands that start or drive programs (add, send, keys, rm, attach) still ask.
prefix_rule(
    pattern = ["vivarium", ["ls", "me", "read", "wait", "note", "fork", "move", "focus", "help"]],
    decision = "allow",
    justification = "Vivarium canvas: read tiles, add notes, fork this conversation",
)
`;
const MARKER = ".installed-by-vivarium";

function setup(flags) {
	const home = os.homedir();
	const tilde = (f) => f.replace(home, "~");
	const skill = [path.join(__dirname, "SKILL.md"), path.join(__dirname, "..", "skill", "SKILL.md")].find((f) => fs.existsSync(f));
	const remove = !!flags.remove;
	for (const dir of [path.join(home, ".agents", "skills", "vivarium"), path.join(home, ".claude", "skills", "vivarium")]) {
		const ours = fs.existsSync(path.join(dir, MARKER));
		if (fs.existsSync(dir) && !ours) { console.log(`skipped  ${tilde(dir)} (a skill of yours with the same name)`); continue; }
		if (remove) { if (ours) { fs.rmSync(dir, { recursive: true, force: true }); console.log(`removed  ${tilde(dir)}`); } continue; }
		if (!skill) die("SKILL.md not found next to the CLI");
		fs.mkdirSync(dir, { recursive: true });
		fs.copyFileSync(skill, path.join(dir, "SKILL.md"));
		fs.writeFileSync(path.join(dir, MARKER), "This folder is managed by the Vivarium Obsidian plugin.\n");
		console.log(`skill    ${tilde(dir)}`);
	}
	const rules = path.join(home, ".codex", "rules", "vivarium.rules");
	const theirs = fs.existsSync(rules) && !fs.readFileSync(rules, "utf8").includes("Written by the Vivarium plugin");
	if (flags["codex-rules"] && !remove && theirs) {
		console.log(`kept     ${tilde(rules)} (not written by Vivarium)`);
	} else if (flags["codex-rules"] && !remove) {
		fs.mkdirSync(path.dirname(rules), { recursive: true });
		fs.writeFileSync(rules, CODEX_RULES);
		console.log(`rule     ${tilde(rules)} (Codex runs ls/me/read/wait/note/fork/move/focus without asking)`);
	} else if (remove && fs.existsSync(rules) && fs.readFileSync(rules, "utf8").includes("Written by the Vivarium plugin")) {
		fs.unlinkSync(rules);
		console.log(`removed  ${tilde(rules)}`);
	}
	// earlier versions wrote a block into these instead of a skill
	for (const f of [path.join(home, ".codex", "AGENTS.md"), path.join(home, ".claude", "CLAUDE.md")]) {
		let t; try { t = fs.readFileSync(f, "utf8"); } catch { continue; }
		const n = t.replace(/\n*<!-- vivarium -->[\s\S]*?<!-- \/vivarium -->\n?/, "\n");
		if (n !== t) { n.trim() ? fs.writeFileSync(f, n.replace(/\n+$/, "\n")) : fs.unlinkSync(f); console.log(`cleaned  ${tilde(f)} (old instructions block; the skill replaces it)`); }
	}
}

// ---------- commands ----------

(async () => {
	const [cmd, ...rest] = process.argv.slice(2);
	const { flags, pos } = parse(rest);
	if (!cmd || cmd === "help" || flags.help || cmd === "-h" || cmd === "--help") return console.log(HELP);
	const out = (res, human) => console.log(flags.json ? JSON.stringify(res, null, 2) : human(res));
	const xy = (s) => { const [x, y] = String(s).split(",").map(Number); return { x, y }; };
	const wh = (s) => { const [width, height] = String(s).split("x").map(Number); return { width, height }; };
	const near = flags.near || HERE || undefined;
	const warn = (r) => r.warning && process.stderr.write(`vivarium: ${r.warning}\n`);
	try {
		switch (cmd) {
			case "ls": {
				const res = await rpc(flags.vault, { op: "list", programsOnly: !flags.all });
				return out(res, (r) => r.nodes.map((n) => {
					const where = flags.all ? `  ${Math.round(n.x)},${Math.round(n.y)} ${Math.round(n.width)}x${Math.round(n.height)}  ${n.canvas}` : "";
					if (n.kind === "program") return `${n.id}  ${n.title}${n.running ? "" : " (stopped)"}  [${n.command || "shell"}]${where}${n.id === HERE ? "  <- you" : ""}`;
					return `${n.kind.padEnd(7)}  ${(n.text || n.file || n.url || n.label || "").replace(/\s+/g, " ").slice(0, 60)}${where}`;
				}).filter((l, i, a) => a.indexOf(l) === i).join("\n") || "(no tiles on open canvases)");
			}
			case "me": {
				const res = await rpc(flags.vault, { op: "me", id: takeId(pos) });
				return out(res, (r) => [
					`${r.id}  ${r.title ?? "(not on an open canvas)"}${r.canvas ? `  on ${r.canvas}` : ""}`,
					r.cwd && `cwd ${r.cwd}`,
					r.agent ? `${r.agent.kind} conversation ${r.agent.sessionId}` : null,
				].filter(Boolean).join("\n"));
			}
			case "add": {
				const req = { op: "add", command: pos.join(" "), title: flags.title, cwd: flags.cwd || (HERE ? process.cwd() : undefined), near, nearExplicit: !!flags.near, edge: !flags["no-edge"], label: flags.label };
				if (flags.at) Object.assign(req, xy(flags.at));
				if (flags.size) Object.assign(req, wh(flags.size));
				const res = await rpc(flags.vault, req);
				warn(res);
				return out(res, (r) => r.id);
			}
			case "fork": {
				const id = flags.near || takeId([]);
				// Codex tells the commands it runs which conversation they belong to.
				const session = process.env.CODEX_THREAD_ID || undefined;
				// `from`: the tile this runs in. Only a fork of your own conversation keeps your tile's flags.
				const res = await rpc(flags.vault, { op: "fork", id, from: process.env.VIVARIUM_TILE || undefined, session, kind: session ? "codex" : undefined, prompt: pos.join(" "), title: flags.title });
				warn(res);
				return out(res, (r) => r.id);
			}
			case "note": {
				const res = await rpc(flags.vault, { op: "note", text: pos.join(" "), near, color: flags.color, edge: !flags["no-edge"], label: flags.label });
				return out(res, (r) => r.nodeId);
			}
			case "send": {
				const id = takeId(pos);
				const text = pos.join(" ");
				if (text) tmux("send-keys", "-t", target(id), "-l", text);
				if (!flags["no-enter"]) tmux("send-keys", "-t", target(id), "Enter");
				if (flags.wait) printWait(waitDone(id, { idle: +flags.idle || 3, timeout: +flags.timeout || 300, pattern: flags.for }), flags);
				return;
			}
			case "wait": {
				const id = takeId(pos);
				printWait(waitDone(id, { idle: +flags.idle || 3, timeout: +flags.timeout || 300, pattern: flags.for, minMs: 0 }), flags);
				return;
			}
			case "keys": {
				const id = takeId(pos);
				if (!pos.length) die("which keys? e.g. vivarium keys t123 C-c");
				tmux("send-keys", "-t", target(id), ...pos);
				return;
			}
			case "read": {
				const id = takeId(pos);
				process.stdout.write(compact(capture(id, parseInt(flags.lines || "0", 10))));
				return;
			}
			case "move": {
				const id = takeId(pos);
				const req = { op: "move", id, ...(pos[0] ? xy(pos[0]) : {}), ...(pos[1] ? wh(pos[1]) : {}) };
				return out(await rpc(flags.vault, req), (r) => `${r.x},${r.y} ${r.width}x${r.height}`);
			}
			case "focus":
				await rpc(flags.vault, { op: "focus", id: takeId(pos) });
				return;
			case "rm": {
				// never your own tile by default: an agent must not remove itself by accident
				const id = takeId(pos, { here: false });
				await rpc(flags.vault, { op: "rm", id }).catch(() => tmux("kill-window", "-t", target(id)));
				return;
			}
			case "attach": {
				const id = takeId(pos);
				const r = require("child_process").spawnSync(TMUX, ["-L", SOCKET, "attach", "-t", target(id)], { stdio: "inherit" });
				process.exit(r.status ?? 0);
			}
			case "setup":
				return setup(flags);
			default:
				die(`unknown command "${cmd}" (try: vivarium help)`);
		}
	} catch (e) {
		die(e.message);
	}
})();
