{
  "name": "obsidian-vivarium",
  "version": "0.1.1",
  "description": "Live program tiles (terminals, agents, dev servers) for Obsidian Canvas, backed by tmux.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint src",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "esbuild": "^0.24.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.6.0",
    "obsidian": "^1.14.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "ws": "^8.23.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0"
  }
}
